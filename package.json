{
  "name": "game-dd",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @game/api",
    "dev:web": "npm run dev --workspace @game/web",
    "test": "tsx --test tests/*.test.ts",
    "ai:cost": "tsx scripts/ai-cost-report.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "build": "tsc --noEmit && npm run build --workspace @game/web",
    "start": "npm run start --workspace @game/api"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^18.0.4",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
