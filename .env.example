# 可使用兼容 OpenAI Chat Completions 的服务。未配置时启动可试玩的演示对话模式。
AI_API_KEY=
AI_BASE_URL=https://api.cottoken.com/v1
AI_MODEL=Cot-18
# 兼容 OpenAI stream_options.include_usage 的服务可设为 1；不支持时请留空。
AI_STREAM_USAGE=
# 小说／角色卡导入专用的主模型，不与游戏聊天模型共用配置。
AI_MAIN_API_KEY=
AI_MAIN_BASE_URL=
AI_MAIN_MODEL=
AI_MAIN_STREAM_USAGE=
AI_FALLBACK_1_API_KEY=
AI_FALLBACK_1_BASE_URL=
AI_FALLBACK_1_MODEL=
AI_FALLBACK_2_API_KEY=
AI_FALLBACK_2_BASE_URL=
AI_FALLBACK_2_MODEL=
AI_FALLBACK_3_API_KEY=
AI_FALLBACK_3_BASE_URL=
AI_FALLBACK_3_MODEL=
PORT=3001
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# 可选：服务器 CA 证书路径；配置后验证服务端身份。未配置时仅强制加密传输。
# MYSQL_SSL_CA=/path/to/mysql-ca.pem
# 本地开发默认只监听 127.0.0.1；正式部署可显式设置 GAME_API_HOST=0.0.0.0
# GAME_API_HOST=127.0.0.1
# 仅本地开发规则诊断；生产模式始终关闭
# GAME_DEV_DEBUG=1

AI_FALLBACK_1_API_KEY=
AI_FALLBACK_1_BASE_URL=
AI_FALLBACK_1_MODEL=

AI_FALLBACK_2_API_KEY=
AI_FALLBACK_2_BASE_URL=
AI_FALLBACK_2_MODEL=

AI_FALLBACK_3_API_KEY=
