# 可使用兼容 OpenAI Chat Completions 的服务。未配置时启动可试玩的演示对话模式。
AI_API_KEY=
AI_BASE_URL=https://api.cottoken.com/v1
AI_MODEL=Cot-18
PORT=3001
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# 可选：服务器 CA 证书路径；配置后验证服务端身份。未配置时仅强制加密传输。
# MYSQL_SSL_CA=/path/to/mysql-ca.pem
# 本地开发默认只监听 127.0.0.1；正式部署可显式设置 GAME_API_HOST=0.0.0.0
# GAME_API_HOST=127.0.0.1
# 仅本地开发规则诊断；生产模式始终关闭
# GAME_DEV_DEBUG=1
